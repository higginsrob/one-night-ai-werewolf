# Device: mps (Apple Silicon native), cuda:0 (NVIDIA Spark/DGX = CUDA 13), or cpu
DEVICE=mps

# Listen port
PORT=8880

# HuggingFace model id / cache
MODEL_ID=k2-fsa/OmniVoice
HF_HOME=./data/models

# Optional mirror when HF downloads fail
# HF_ENDPOINT=https://hf-mirror.com

# Optional Hugging Face token (faster / higher limits for first model download)
# HF_TOKEN=hf_...

# Admin UI / DELETE override (leave empty to disable admin auth gate in UI)
ADMIN_TOKEN=change-me

# MPS stability (recommended on Apple Silicon)
MPS_FLOAT32=1
MPS_EAGER_ATTN=1
